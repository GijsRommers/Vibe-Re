@implements IAsyncDisposable
@inject BrowserServer Server
@inject BrowserAccessClient Access
@inject ClientStartup Startup
@inject NavigationManager Navigation

<PageTitle>VibeRe</PageTitle>
<main class="shell">
    <header class="server-bar">
        <div>
            <h1>VibeRe</h1>
            <div class="server-label">@Server.Connection.Address</div>
        </div>
        <button class="subtle" @onclick="ToggleServer" disabled="@_busy">Choose server</button>
    </header>

    <div class="content">
        @if (_showServer)
        {
            <section class="section" aria-labelledby="server-heading">
                <h2 id="server-heading">Open another server</h2>
                <form @onsubmit="OpenServer" @onsubmit:preventDefault>
                    <label for="server-address">HTTPS server address</label>
                    <div class="form-row">
                        <input id="server-address" type="url" @bind="_serverAddress" placeholder="https://vibe.example.com" required disabled="@_busy" />
                        <button type="submit" disabled="@_busy">Open server</button>
                    </div>
                </form>
                <p class="hint">Opens that server’s web app. Each server has its own device connection and Mistral login.</p>
            </section>
        }

        <section class="login" aria-label="Mistral login" aria-busy="@_busy">
            @if (_access?.Authorized == true)
            {
                @if (IsSignedIn)
                {
                    <div class="signed-in"><img src="mistral.svg" alt="Mistral" width="70" height="50" /><span>Signed in</span></div>
                }
                else
                {
                    <button class="login-button" @onclick="LoginAsync" disabled="@_busy" aria-label="Login to Mistral">
                        <img src="mistral.svg" alt="" /><span>Login</span>
                    </button>
                }
            }
            else
            {
                <img src="mistral.svg" alt="Mistral" width="70" height="50" />
            }

            <p class="status @(_error ? "error" : "")" role="status" aria-live="polite">@_message</p>
            @if (_browserUrl is { Length: > 0 })
            {
                <a class="button-link browser-link" href="@_browserUrl" target="_blank" rel="noopener noreferrer">Continue in Mistral ↗</a>
                <span class="hint">Open this link to finish signing in. This page will update automatically.</span>
                <a class="browser-url" href="@_browserUrl" target="_blank" rel="noopener noreferrer">@_browserUrl</a>
            }
            @if (_pairing is not null)
            {
                <div class="pairing-code" aria-label="Device approval code">@_pairing.ApprovalCode</div>
                <p class="hint">On the server computer, open its local VibeRe page and enter this code under “Approve a device.” Only approve a code from a device you recognize.</p>
                <p class="hint">Expires at @_pairing.ExpiresAt.ToLocalTime().ToString("t"). Keep this page open.</p>
            }
            @if (_busy)
            {
                <div class="progress" role="progressbar" aria-label="Working"></div>
                <button @onclick="Cancel">Cancel</button>
            }
            else
            {
                <div class="actions">
                    <button @onclick="RefreshAsync">Refresh connection</button>
                    @if (IsSignedIn)
                    {
                        <button @onclick="LogoutAsync">Log out server from Mistral</button>
                    }
                </div>
            }
            @if (_access?.Authorized == true)
            {
                <p class="hint">Mistral sign-in belongs to this server. Logging out affects all its connected devices.</p>
            }
        </section>

        @if (_access is { Authorized: false })
        {
            <section class="section" aria-labelledby="pair-heading">
                <h2 id="pair-heading">Connect this browser</h2>
                <form @onsubmit="PairAsync" @onsubmit:preventDefault>
                    <label for="device-name">Device name</label>
                    <div class="form-row">
                        <input id="device-name" @bind="_deviceName" maxlength="80" required placeholder="My laptop" disabled="@_busy" autocomplete="off" />
                        <button type="submit" disabled="@_busy">Get pairing code</button>
                    </div>
                </form>
                <p class="hint">A trusted person at the server must approve this browser. Access is stored in a secure, HttpOnly cookie.</p>
            </section>
            @if (_access.IsLocal)
            {
                <section class="section" aria-labelledby="local-heading">
                    <h2 id="local-heading">Unlock this local server</h2>
                    <form @onsubmit="UnlockLocalAsync" @onsubmit:preventDefault>
                        <label for="admin-token">Configured server access token</label>
                        <div class="form-row">
                            <input id="admin-token" type="password" @bind="_adminToken" @bind:event="oninput" autocomplete="off" spellcheck="false" disabled="@_busy" required />
                            <button type="submit" disabled="@_busy">Unlock</button>
                        </div>
                    </form>
                    <p class="hint">Only available on the server’s own loopback address. The token is cleared after use.</p>
                </section>
            }
        }

        @if (_access?.CanManageDevices == true)
        {
            <details class="device-management">
                <summary>Manage devices</summary>
                <section class="section" aria-labelledby="approve-heading">
                    <h2 id="approve-heading">Approve a device</h2>
                    <form @onsubmit="ApproveAsync" @onsubmit:preventDefault>
                        <label for="approval-code">Code shown on the other device</label>
                        <div class="form-row">
                            <input id="approval-code" @bind="_approvalCode" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="32" required disabled="@_busy" placeholder="Approval code" />
                            <button type="submit" disabled="@_busy">Approve</button>
                        </div>
                    </form>
                    <p class="hint">Approval lets that device use this server’s Mistral account. Verify the device and code first.</p>
                </section>
                <section class="section" aria-labelledby="devices-heading">
                    <h2 id="devices-heading">Connected devices</h2>
                    @if (_devices.Length == 0)
                    {
                        <p class="hint">No paired devices yet.</p>
                    }
                    else
                    {
                        <ul class="device-list">
                            @foreach (var device in _devices)
                            {
                                <li @key="device.Id">
                                    <div class="device-name">@device.Name
                                        <span class="device-detail">@(device.RevokedAt is null ? $"Expires {device.ExpiresAt.ToLocalTime():g}" : "Revoked")</span>
                                    </div>
                                    @if (device.RevokedAt is null)
                                    {
                                        <button @onclick="() => RevokeAsync(device.Id)" disabled="@_busy" aria-label="@($"Revoke {device.Name}")">Revoke</button>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    <p class="hint">Revoking a device removes its access. Your server’s Mistral sign-in stays active.</p>
                    <button @onclick="RefreshDevicesAsync" disabled="@_busy">Refresh devices</button>
                </section>
            </details>
        }

        @if (_access is { Authorized: false } or { Authorized: true, IsLocal: false } || _access?.DeviceName is not null)
        {
            <section class="section">
                @if (_access?.DeviceName is { } name)
                {
                    <p class="hint">This browser: @name@(_access.ExpiresAt is { } expiry ? $" · expires {expiry.ToLocalTime():g}" : "")</p>
                }
                <button @onclick="DisconnectAsync" disabled="@_busy">@(_access?.Authorized == false ? "Reset this browser connection" : "Disconnect this browser")</button>
                <p class="hint">Removes this browser’s device access. It does not log the server out of Mistral.</p>
            </section>
        }
        <footer>VibeRe · Your server, your session</footer>
    </div>
</main>
