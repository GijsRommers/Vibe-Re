<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\VibeRe.Application\VibeRe.Application.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12"/>
    </ItemGroup>

    <!-- The user guide ships inside the binary, so search_docs always matches the installed version. -->
    <ItemGroup>
        <EmbeddedResource Include="..\docs\guide\**\*.md" LogicalName="docs/%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="VibeRe.Tools.Tests"/>
    </ItemGroup>

</Project>
