<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VibeRe.Desktop.Views.UpdatesWindow"
        Title="VibeRe updates" Width="560" Height="540" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#101010" Foreground="#F5F5F5">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock Text="VibeRe updates" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Name="VersionLabel" TextWrapping="Wrap" />
        <TextBlock Name="StatusLabel" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <ProgressBar Name="Progress" Height="4" IsVisible="False" />
        <TextBlock Name="ConsentText" IsVisible="False" TextWrapping="Wrap"
                   Text="Installing closes VibeRe and stops local servers started by this installation. Other clients using those servers will disconnect. Your saved settings and credentials stay in place. VibeRe restarts after installation." />
        <CheckBox Name="Consent" IsVisible="False" Content="I've saved my work and am ready to restart"
                  IsCheckedChanged="ConsentChanged" />
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Name="CheckButton" Content="Check for updates" Click="CheckForUpdates" />
            <Button Name="DownloadButton" Content="Download update" IsVisible="False" Click="DownloadUpdate" />
            <Button Name="ApplyButton" Content="Install and restart" IsVisible="False" IsEnabled="False" Click="ApplyUpdate" />
        </StackPanel>
        <HyperlinkButton Content="Open official releases and installers" NavigateUri="https://github.com/GijsRommers/Vibe-Re/releases" />
        <TextBlock Text="Updates come from the official GijsRommers/Vibe-Re GitHub releases. A connection or download error leaves your current installation usable."
                   TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="12" />
    </StackPanel>
    </ScrollViewer>
</Window>
